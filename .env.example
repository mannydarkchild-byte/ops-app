# Copy to .env (local) or set in Vercel → Project → Settings → Environment Variables.
# Dashboard → Project Settings → API
#
# Never put the service_role key in the frontend. Anon/public key only.
#
# Live Supabase checklist (Dashboard — not set here):
# 1) SQL: apply migrations 020, 021, 022 (in order)
# 2) Auth → Providers → Email → turn OFF "Enable sign ups"
# 3) Deploy Edge Function: supabase functions deploy admin-create-user
#    (service_role stays on the function runtime; never in VITE_*)

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: landing-page demo form mailto target
# VITE_DEMO_EMAIL=ops@example.com
