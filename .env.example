# Copy to .env (local) or set in Vercel → Project → Settings → Environment Variables.
# Dashboard → Project Settings → API
#
# Never put the service_role key in the frontend. Anon/public key only.
# Before launch: disable public sign-ups in Supabase Auth (invite/admin-create only).

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: landing-page demo form mailto target
# VITE_DEMO_EMAIL=ops@example.com
